# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/
ENV/

# Django stuff:
# Database file - do not commit local sqlite databases
db.sqlite3

# Django static and media (if generated locally)
staticfiles/
media/

# Migrations - keep these in repo for most projects; uncomment to ignore
# core/migrations/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store

# Logs
*.log
logs/

# Pytest
.pytest_cache/

# Coverage
.coverage
coverage.xml

# MyPy
.mypy_cache/

# Environment variables
.env
.env.*

# Temporary files
*.swp
*.tmp
